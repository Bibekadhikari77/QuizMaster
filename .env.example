# Django Secret Key
# For development: use the default below or generate a new one
# For production: MUST generate a secure key using: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=django-insecure-dev-key-change-this-in-production-x8f9#mq2!k@l3n4p5

# Debug mode (set to False in production)
DEBUG=True

# OpenAI API Key (for AI quiz generation)
# Get your key from: https://platform.openai.com/api-keys
# Format: sk-proj-xxxxxxxxxxxxxxxxxxxx or sk-xxxxxxxxxxxxxxxxxxxx
# Leave empty to use fallback sample quizzes
OPENAI_API_KEY=

# Google Gemini API Key (alternative AI option)
# Get your key from: https://aistudio.google.com/app/apikey
# Format: AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxx
# Note: Current implementation uses OpenAI. To use Gemini, modify quiz/ai_generator.py
GEMINI_API_KEY=
